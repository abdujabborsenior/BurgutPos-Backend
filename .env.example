# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# Business time zone: reports, "today" on the dashboard, Excel dates
APP_TIMEZONE=Asia/Tashkent
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Set to true when running behind nginx / a load balancer
TRUST_PROXY=false

# ─── PostgreSQL ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=burgutpos
DB_SSL=false
DB_LOGGING=false
# Apply pending migrations automatically on startup
DB_MIGRATIONS_RUN=true
DB_POOL_SIZE=20

# ─── Authentication ────────────────────────────────────────────
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# true in production (HTTPS only)
COOKIE_SECURE=false

# ─── Superadmin (synchronised with the database on every start) ─
SUPERADMIN_LOGIN=BurgutPos
SUPERADMIN_PASSWORD=Burgut1998
SUPERADMIN_NAME=Суперадмин

# ─── Изображения (фото блюд, логотип чека) ─────────────────────
# local — файлы лежат на этом сервере и раздаются им же (UPLOAD_DIR)
# bunny — файлы уходят в Bunny Storage и раздаются через pull zone
STORAGE_DRIVER=local
# Папка для STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Заполняется только при STORAGE_DRIVER=bunny (ключи берутся в панели bunny.net):
# Storage → ваша зона → FTP & API Access
#   BUNNY_STORAGE_ZONE     — имя storage-зоны
#   BUNNY_STORAGE_PASSWORD — пароль зоны (Password), даёт запись; наружу не уходит
#   BUNNY_STORAGE_HOST     — хост региона зоны: storage.bunnycdn.com (EU),
#                            ny./la./sg./syd./uk./se./br./jh.storage.bunnycdn.com
#   BUNNY_PULL_ZONE_URL    — адрес pull-зоны, с https:// и без слэша в конце
#   BUNNY_FOLDER           — необязательная папка внутри зоны (например, имя заведения)
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_PULL_ZONE_URL=
BUNNY_FOLDER=

# ─── Misc ──────────────────────────────────────────────────────
SWAGGER_ENABLED=true
